<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#060B19"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NGUIRAZE NET"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- Parte Superior: Anel de GB Vendidos + Detalhes à Direita -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#0A1633"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="18dp"
            android:layout_marginBottom="16dp">

            <FrameLayout
                android:layout_width="126dp"
                android:layout_height="126dp"
                android:layout_marginEnd="16dp">

                <ProgressBar
                    android:id="@+id/progressGb"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:indeterminate="false"
                    android:max="100"
                    android:progress="0" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:id="@+id/tvGbVendidos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0,00"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GB vendidos"
                        android:textColor="#94A3B8"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTotalAtendidos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="transferências"
                    android:textColor="#CBD5E1"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Concluídos hoje"
                    android:textColor="#22C55E"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:id="@+id/tvMetaResumo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Meta: 1000 GB"
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvSaldoHoje"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Saldo hoje: 0 MT"
                    android:textColor="#E2E8F0"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Barra de Navegação -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <Button
                android:id="@+id/btnEnviar"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Enviar"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#1D4ED8"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnFila"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Fila"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#1E3A8A"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnHistorico"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Histórico"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#1E3A8A"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnMeta"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Meta"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#1E3A8A"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CARTÕES SIM"
            android:textColor="#CBD5E1"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <!-- Cartões SIM 1 e SIM 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="#0A1633"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SIM 1"
                    android:textColor="#60A5FA"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSim1Count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0/10"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="transferências"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btnResetSim1"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:text="Reset"
                    android:textAllCaps="false"
                    android:textColor="#111827"
                    android:textStyle="bold"
                    android:backgroundTint="#D97706" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="#0A1633"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginStart="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SIM 2"
                    android:textColor="#4ADE80"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSim2Count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0/10"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="transferências"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btnResetSim2"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:text="Reset"
                    android:textAllCaps="false"
                    android:textColor="#111827"
                    android:textStyle="bold"
                    android:backgroundTint="#D97706" />
            </LinearLayout>
        </LinearLayout>

        <!-- Fila de Espera -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#0A1633"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/tvFilaEspera"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="FILA DE ESPERA (0)"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnPausar"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Pausar"
                android:textAllCaps="false"
                android:textColor="#111827"
                android:textStyle="bold"
                android:backgroundTint="#D97706" />
        </LinearLayout>

        <!-- Últimos Pedidos -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Últimos pedidos"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvUltimosPedidos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sem pedidos ainda."
            android:textColor="#94A3B8"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
